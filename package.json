{
  "name": "niva",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NIVA - Digital Life OS. Every deadline in your real life, in one place.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc -b && vite build && node scripts/build-404.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "oxlint src server scripts",
    "test": "vitest run",
    "zip": "node scripts/make-zip.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "oxlint": "^1.15.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
