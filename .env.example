# NIVA — AI configuration
#
# The API key is read by server/index.js ONLY. Never put a key in a VITE_*
# variable, in src/, or anywhere that gets committed.
# Copy this file to .env (git-ignored) and fill in the key.

# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — any model id your key can reach.
# NIVA_MODEL=gemini-2.5-flash

# Optional — change the proxy port if 8788 is taken.
# PORT=8788
